{
  "entities": {
    "UserDocument": {
      "title": "UserDocument",
      "description": "User profile information, developer settings, and all workspace data in AppDock75.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "User display name" },
        "avatar": { "type": "string", "description": "Avatar image URL" },
        "providers": { "type": "array", "description": "Linked authentication providers" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "settings": { "type": "object", "description": "Developer profile settings including bundlePrefix, dateFormat, theme" },
        "ideas": { "type": "array", "description": "List of brainstormed ideas" },
        "projects": { "type": "array", "description": "List of iOS projects with bundleId, minIOS, stack, platforms, dates" },
        "tasks": { "type": "array", "description": "List of Kanban tasks and subtasks" },
        "releases": { "type": "array", "description": "List of versions and releases" },
        "changelogEntries": { "type": "array", "description": "Changelog items" },
        "archivedApps": { "type": "array", "description": "Archived published apps" },
        "statuses": { "type": "array", "description": "Custom workflow statuses" },
        "checklists": { "type": "array", "description": "App Store submission checklists" },
        "checklistTemplate": { "type": "array", "description": "Global App Store checklist template items" },
        "privacyPermissions": { "type": "array", "description": "Privacy and permission strings" },
        "certificates": { "type": "array", "description": "Certificate expiry reminders" },
        "notifications": { "type": "array", "description": "Developer notification items" }
      },
      "required": ["id", "email", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserDocument" },
      "description": "User profile, developer settings, and complete workspace data in the users collection."
    }
  }
}
